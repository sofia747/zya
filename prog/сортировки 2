//10)Нечетные строки по убыванию, четные по возрастанию помощью гномьей сортировки
#include<iostream>
#include<fstream>
#include<vector>
using namespace std;

void gnomA(vector<int>& a) {
	int i = 0;
	while (i < a.size()) {
		if (i == 0 || a[i] >= a[i - 1]) {
			i++;
		}
		else {
			swap(a[i], a[i - 1]);
			i--;
		}
	}
}

void gnomZ(vector<int>& a) {
	int i = 0;
	while (i < a.size()) {
		if (i == 0 || a[i] <= a[i - 1]) {
			i += 1;
		}
		else {
			swap(a[i], a[i - 1]);
			i--;
		}
	}
}

void pr(const vector<vector<int>>& a) {
	int n = a.size();
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++) {
			cout << a[i][j] << " ";
		}
		cout << endl;
	}
}

int main() {
	ifstream input("input.txt");
	ofstream output("output.txt"); 

	int n;
	input >> n;

	vector<vector<int>> a(n, vector<int>(n));
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++) {
			input >> a[i][j];
		}
	}

	for (int i = 0; i < n; i++) {
		if (i % 2 == 0) gnomA(a[i]);
		else gnomZ(a[i]);
	}

	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++) {
			output << a[i][j] << " ";
		}
		output << endl;
	}
	input.close();
	output.close();

	pr(a);

	return 0;
}
