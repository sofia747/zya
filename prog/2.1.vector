//Дан набор целых чисел. Удалить все максимальные числа.
#include<iostream>
using namespace std;
#include<vector>

int main() {
	srand((unsigned)time(NULL));
	int n;
	cout << "n = "; cin >> n;
	vector<int>a;
	for (int i = 0; i < n; i++)
		a.push_back(rand()%10);

	for (int i = 0; i < a.size(); i++)
		cout << a[i] << " ";
	cout << endl;

	int Max = *max_element(a.begin(), a.end());
	vector<int>::iterator it = remove(a.begin(), a.end(), Max);
	a.erase(it, a.end());

	for (vector<int>::iterator iter = a.begin(); iter != a.end(); iter++)
		cout << *iter << " ";
	cout << endl;

	system("pause");
	return 0;
}
