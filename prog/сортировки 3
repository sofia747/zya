//15)Диагонали, параллельные побочной по возрастанию с помощью сортировки вставками
#include<iostream>
#include<vector>
#include<fstream>
using namespace std;

void sor(vector<int>& a) {
	for (int i = 1; i < a.size(); i++) {
		int key = a[i];
		int j = i - 1;

		while (j >= 0 && a[j] > key) {
			a[j + 1] = a[j];
			j--;
		}
		a[j + 1] = key;
	}
}

void pr(const vector<vector<int>>& a) {
	int n = a.size();
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++) {
			cout << a[i][j] << " ";
		}
		cout << endl;
	}
}

int main() {
	ifstream input("input.txt");
	ofstream output("output.txt");
	int n;
	input >> n;

	vector<vector<int>> a(n, vector<int>(n));
	for (int i = 0; i < n; i++)
		for (int j = 0; j < n; j++)
			input >> a[i][j];

	for (int s = 0; s <= 2 * n - 2; s++) {
		vector<int> d;
		vector<int> rows;
		vector<int>cols;

		for (int i = 0; i < n; i++) {
			int j = s - i;

			if (j >= 0 && j < n) {
				d.push_back(a[i][j]);
				rows.push_back(i);
				cols.push_back(j);
			}
		}

		sor(d);
		for (int k = 0; k < d.size(); k++)
			a[rows[k]][cols[k]] = d[k];

		for (int i = 0; i < n; i++) {
			for (int j = 0; j < n; j++) {
				output << a[i][j]<<" ";
			}
			output << endl;
		}
	}
	pr(a);
	input.close();
	output.close();
	return 0;
}
